/* 2. DOM ELEMENTS */

const audioPlayer = document.getElementById("audioPlayer");

const tracksContainer =
    document.getElementById("tracksContainer");

const searchInput =
    document.getElementById("searchInput");

const largeSearchInput =
    document.getElementById("largeSearchInput");

const clearSearchBtn =
    document.getElementById("clearSearchBtn");

const playerTitle =
    document.getElementById("playerTitle");

const playerArtist =
    document.getElementById("playerArtist");

const playerArt =
    document.getElementById("playerArt");

const playBtn =
    document.getElementById("playBtn");

const prevBtn =
    document.getElementById("prevBtn");

const nextBtn =
    document.getElementById("nextBtn");

const shuffleBtn =
    document.getElementById("shuffleBtn");

const repeatBtn =
    document.getElementById("repeatBtn");

const progressBar =
    document.getElementById("progressBar");

const volumeBar =
    document.getElementById("volumeBar");

const currentTimeDisplay =
    document.getElementById("currentTime");

const totalDurationDisplay =
    document.getElementById("totalDuration");

const playlistList =
    document.getElementById("playlistList");


/* 3. PLAYER STATE */

let currentTrackIndex = -1;

let currentQueue = playlist.map(song => song.id);

let isPlaying = false;

let isShuffle = false;

// Repeat modes: 0 = Off, 1 = Repeat All, 2 = Repeat One
let repeatMode = 0;

let selectedPlaylistId = null;

let currentView = "home";

const playlists = [
    {
        id: 1,
        name: "Favorites",
        songs: [1, 2]
    },
    {
        id: 2,
        name: "Chill Vibe",
        songs: [2, 3, 4, 5]
    }
];

let nextPlaylistId = 3;


/* 4. HELPER FUNCTIONS */

function getSongById(id) {
    return playlist.find(song => song.id === id);
}

function getCurrentSong() {
    return getSongById(currentQueue[currentTrackIndex]);
}

function formatTime(seconds) {
    if (!Number.isFinite(seconds)) return "0:00";

    const minutes = Math.floor(seconds / 60);

    const remainingSeconds = Math.floor(seconds % 60);

    return `${minutes}:${String(remainingSeconds).padStart(2, "0")}`;
}


/* 5. RENDER SONGS */

function renderSongs(songs, container = tracksContainer) {

    container.innerHTML = "";

    songs.forEach((song, index) => {

        const isCurrent =
            getCurrentSong()?.id === song.id && isPlaying;

        const item = document.createElement("div");

        item.className =
            "track-item" + (isCurrent ? " playing" : "");

        item.innerHTML = `
            <span class="track-number">
                ${index + 1}
            </span>

            <div class="track-info">

                <img
                    class="track-image"
                    src="${song.image}"
                    alt="${song.title}"
                >

                <div class="track-details">

                    <div class="track-title">
                        ${song.title}
                    </div>

                    <div class="track-artist">
                        ${song.artist}
                    </div>

                </div>

            </div>

            <span class="track-album">
                ${song.album}
            </span>

            <span class="track-duration">
                ${song.duration}
            </span>

            <button class="track-add" title="Add to playlist">
                +
            </button>
        `;

        // Play selected song
        item.addEventListener("click", (event) => {

            if (event.target.closest(".track-add")) return;

            playSong(song.id, songs.map(s => s.id));

        });

        // Add song to selected playlist
        item.querySelector(".track-add")
            .addEventListener("click", (event) => {

                event.stopPropagation();

                addSongToPlaylist(song.id);

            });

        // Handle missing artwork
        item.querySelector(".track-image").addEventListener(
            "error",
            (event) => {
                event.target.style.display = "none";
            }
        );

        container.appendChild(item);

    });

}


/* 6. HOME PAGE */

function renderHome() {

    renderSongs(playlist, tracksContainer);

    document.getElementById("emptyMessage").hidden =
        playlist.length > 0;

}


/* 7. PLAY SONG */

function playSong(songId, queue = currentQueue) {

    const song = getSongById(songId);

    if (!song) return;

    currentQueue = [...queue];

    currentTrackIndex = currentQueue.indexOf(songId);

    if (currentTrackIndex === -1) return;

    playerTitle.textContent = song.title;

    playerArtist.textContent = song.artist;

    playerArt.innerHTML = `
        <img src="${song.image}" alt="${song.title}">
    `;

    audioPlayer.src = song.audio;

    audioPlayer.load();

    audioPlayer.play()
        .catch(error => {

            console.error("Audio playback error:", error);

            isPlaying = false;

            playBtn.textContent = "▶";

            renderCurrentView();

        });

}


/* 8. PLAY / PAUSE */

function togglePlay() {

    if (currentTrackIndex === -1) {

        playSong(playlist[0].id, playlist.map(song => song.id));

        return;

    }

    if (audioPlayer.paused) {

        audioPlayer.play()
            .catch(error => console.error(error));

    } else {

        audioPlayer.pause();

    }

}


/* 9. AUDIO EVENTS */

audioPlayer.addEventListener("play", () => {

    isPlaying = true;

    playBtn.textContent = "⏸";

    renderCurrentView();

});


audioPlayer.addEventListener("pause", () => {

    isPlaying = false;

    playBtn.textContent = "▶";

    renderCurrentView();

});


audioPlayer.addEventListener("loadedmetadata", () => {

    totalDurationDisplay.textContent =
        formatTime(audioPlayer.duration);

});


audioPlayer.addEventListener("timeupdate", () => {

    if (!audioPlayer.duration) return;

    const progress =
        (audioPlayer.currentTime / audioPlayer.duration) * 100;

    progressBar.value = progress;

    currentTimeDisplay.textContent =
        formatTime(audioPlayer.currentTime);

});


/* 10. PROGRESS BAR */

progressBar.addEventListener("input", () => {

    if (!audioPlayer.duration) return;

    audioPlayer.currentTime =
        (progressBar.value / 100) * audioPlayer.duration;

});


/* 11. VOLUME CONTROL */

audioPlayer.volume = 0.8;

volumeBar.addEventListener("input", () => {

    audioPlayer.volume = volumeBar.value / 100;

});


/* 12. NEXT SONG */

function nextSong() {

    if (currentQueue.length === 0) return;

    if (repeatMode === 2 && currentTrackIndex !== -1) {

        audioPlayer.currentTime = 0;

        audioPlayer.play().catch(console.error);

        return;

    }

    let nextIndex;

    if (isShuffle && currentQueue.length > 1) {

        do {

            nextIndex = Math.floor(
                Math.random() * currentQueue.length
            );

        } while (nextIndex === currentTrackIndex);

    } else {

        nextIndex = currentTrackIndex + 1;

    }

    if (nextIndex >= currentQueue.length) {

        if (repeatMode === 1) {

            nextIndex = 0;

        } else {

            audioPlayer.pause();

            audioPlayer.currentTime = 0;

            progressBar.value = 0;

            currentTrackIndex = -1;

            playerTitle.textContent = "Playback finished";

            playerArtist.textContent = "Choose another song";

            playerArt.innerHTML = "♫";

            renderCurrentView();

            return;

        }

    }

    playSong(currentQueue[nextIndex], currentQueue);

}


/* 13. PREVIOUS SONG */

function previousSong() {

    if (currentQueue.length === 0) return;

    if (audioPlayer.currentTime > 3) {

        audioPlayer.currentTime = 0;

        return;

    }

    let previousIndex = currentTrackIndex - 1;

    if (previousIndex < 0) {

        previousIndex =
            repeatMode === 1 ? currentQueue.length - 1 : 0;

    }

    playSong(currentQueue[previousIndex], currentQueue);

}


/* 14. PLAYER BUTTON EVENTS */

playBtn.addEventListener("click", togglePlay);

nextBtn.addEventListener("click", nextSong);

prevBtn.addEventListener("click", previousSong);

audioPlayer.addEventListener("ended", nextSong);


/* 15. SHUFFLE */

shuffleBtn.addEventListener("click", () => {

    isShuffle = !isShuffle;

    shuffleBtn.classList.toggle("enabled", isShuffle);

});


/* 16. REPEAT */

repeatBtn.addEventListener("click", () => {

    repeatMode = (repeatMode + 1) % 3;

    repeatBtn.classList.toggle(
        "enabled",
        repeatMode !== 0
    );

    repeatBtn.textContent =
        repeatMode === 2 ? "🔂" : "🔁";

    repeatBtn.title =
        ["Repeat Off", "Repeat All", "Repeat One"][repeatMode];

});


/* 17. PLAY ALL */

document.getElementById("playAllBtn")
    .addEventListener("click", () => {

        const allSongs = playlist.map(song => song.id);

        if (allSongs.length) {

            playSong(allSongs[0], allSongs);

        }

    });


/* 18. SHUFFLE ALL */

document.getElementById("shuffleAllBtn")
    .addEventListener("click", () => {

        const shuffled = [...playlist]
            .map(song => song.id)
            .sort(() => Math.random() - 0.5);

        isShuffle = true;

        shuffleBtn.classList.add("enabled");

        playSong(shuffled[0], shuffled);

    });


/* 19. SEARCH FUNCTION */

function searchSongs(term, container) {

    const query = term.toLowerCase().trim();

    const results = playlist.filter(song =>

        song.title.toLowerCase().includes(query) ||

        song.artist.toLowerCase().includes(query) ||

        song.album.toLowerCase().includes(query)

    );

    renderSongs(results, container);

    return results;

}


searchInput.addEventListener("input", () => {

    largeSearchInput.value = searchInput.value;

    searchSongs(searchInput.value, tracksContainer);

});


largeSearchInput.addEventListener("input", () => {

    searchInput.value = largeSearchInput.value;

    searchSongs(largeSearchInput.value,
        document.getElementById("searchResults"));

});


clearSearchBtn.addEventListener("click", () => {

    searchInput.value = "";

    largeSearchInput.value = "";

    renderHome();

});


/* 20. PLAYLIST MANAGEMENT */

function renderPlaylists() {

    playlistList.innerHTML = "";

    playlists.forEach(userPlaylist => {

        const item = document.createElement("li");

        item.textContent = "♫ " + userPlaylist.name;

        if (selectedPlaylistId === userPlaylist.id) {

            item.classList.add("active");

        }

        item.addEventListener("click", () => {

            openPlaylist(userPlaylist.id);

        });

        playlistList.appendChild(item);

    });

    document.getElementById("playlistCount").textContent =
        playlists.length;

}


function createPlaylist() {

    const name = prompt("Enter your new playlist name:");

    if (!name || !name.trim()) return;

    const newPlaylist = {

        id: nextPlaylistId++,

        name: name.trim(),

        songs: []

    };

    playlists.push(newPlaylist);

    selectedPlaylistId = newPlaylist.id;

    renderPlaylists();

    openPlaylist(newPlaylist.id);

}


document.getElementById("createPlaylistBtn")
    .addEventListener("click", createPlaylist);


/* 21. ADD SONG TO PLAYLIST */

function addSongToPlaylist(songId) {

    // Use the selected playlist, or Favorites by default
    const targetPlaylist =
        playlists.find(p => p.id === selectedPlaylistId) ||
        playlists.find(p => p.name === "Favorites");

    if (!targetPlaylist) return;

    if (targetPlaylist.songs.includes(songId)) {

        alert("This song is already in " + targetPlaylist.name);

        return;

    }

    targetPlaylist.songs.push(songId);

    alert("Song added to " + targetPlaylist.name + "!");

    renderPlaylists();

    if (currentView === "playlist") {

        openPlaylist(targetPlaylist.id);

    }

}


/* 22. OPEN PLAYLIST */

function openPlaylist(id) {

    const userPlaylist =
        playlists.find(p => p.id === id);

    if (!userPlaylist) return;

    selectedPlaylistId = id;

    showView("playlist");

    document.getElementById("playlistTitle").textContent =
        userPlaylist.name;

    document.getElementById("playlistDescription").textContent =
        userPlaylist.songs.length + " songs";

    const songs = userPlaylist.songs
        .map(getSongById)
        .filter(Boolean);

    renderSongs(
        songs,
        document.getElementById("playlistTracks")
    );

    renderPlaylists();

}


document.getElementById("playlistPlayBtn")
    .addEventListener("click", () => {

        const userPlaylist =
            playlists.find(p => p.id === selectedPlaylistId);

        if (!userPlaylist || !userPlaylist.songs.length) {

            alert("This playlist is empty!");

            return;

        }

        playSong(
            userPlaylist.songs[0],
            userPlaylist.songs
        );

    });


/* 23. NAVIGATION */

function showView(view) {

    currentView = view;

    document.querySelectorAll(".content-view")
        .forEach(section => section.hidden = true);

    const selectedView =
        document.getElementById(view + "View");

    if (selectedView) {

        selectedView.hidden = false;

    }

    document.querySelectorAll(".nav-link")
        .forEach(button => {

            button.classList.toggle(
                "active",
                button.dataset.view === view
            );

        });

}


document.querySelectorAll(".nav-link")
    .forEach(button => {

        button.addEventListener("click", () => {

            const view = button.dataset.view;

            showView(view);

            if (view === "home") {

                renderHome();

            }

            if (view === "library") {

                renderLibrary();

            }

            if (view === "search") {

                largeSearchInput.value = searchInput.value;

                searchSongs(
                    searchInput.value,
                    document.getElementById("searchResults")
                );

            }

        });

    });


/* 24. LIBRARY */

function renderLibrary() {

    document.getElementById("songCount").textContent =
        playlist.length;

    document.getElementById("playlistCount").textContent =
        playlists.length;

    renderSongs(
        playlist,
        document.getElementById("libraryTracks")
    );

}


/* 25. QUICK ACCESS CARDS */

document.querySelectorAll(".quick-card")
    .forEach((card, index) => {

        card.addEventListener("click", () => {

            if (index === 0) {

                const favorites =
                    playlists.find(p => p.name === "Favorites");

                if (favorites) openPlaylist(favorites.id);

            } else if (index === 1) {

                const chill =
                    playlists.find(p => p.name === "Chill Vibe");

                if (chill) openPlaylist(chill.id);

            } else {

                const recent = getCurrentSong();

                if (recent) {

                    playSong(recent.id, [recent.id]);

                }

            }

        });

    });


/* 26. REFRESH CURRENT VIEW */

function renderCurrentView() {

    if (currentView === "home") {

        const query = searchInput.value.trim();

        if (query) {

            searchSongs(query, tracksContainer);

        } else {

            renderHome();

        }

    }

    if (currentView === "search") {

        searchSongs(
            largeSearchInput.value,
            document.getElementById("searchResults")
        );

    }

    if (currentView === "library") {

        renderLibrary();

    }

    if (currentView === "playlist") {

        const userPlaylist =
            playlists.find(p => p.id === selectedPlaylistId);

        if (userPlaylist) {

            renderSongs(
                userPlaylist.songs.map(getSongById).filter(Boolean),
                document.getElementById("playlistTracks")
            );

        }

    }

}


/* 27. INITIALIZE PLAYER */

function initializePlayer() {

    renderHome();

    renderPlaylists();

    renderLibrary();

    audioPlayer.volume = 0.8;

    progressBar.value = 0;

    currentTimeDisplay.textContent = "0:00";

    totalDurationDisplay.textContent = "0:00";

}

initializePlayer();


