<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Spotipart - Music Player</title>

    <link rel="stylesheet" href="style.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>

<body>

<div class="app-layout">

    <!-- SIDEBAR -->
    <aside class="sidebar">

        <h1 class="logo">
            <span class="logo-icon">♫</span>
            Spotipart
        </h1>

        <nav class="nav-links">
            <button class="nav-link active" data-view="home">
                <span>⌂</span> Home
            </button>

            <button class="nav-link" data-view="search">
                <span>⌕</span> Search
            </button>

            <button class="nav-link" data-view="library">
                <span>▤</span> Your Library
            </button>
        </nav>

        <div class="sidebar-divider"></div>

        <div class="playlist-heading">
            <h3>Your Playlists</h3>

            <button id="createPlaylistBtn" title="Create playlist">
                +
            </button>
        </div>

        <ul id="playlistList" class="playlist-list">
            <!-- Playlists generated by JavaScript -->
        </ul>

        <div class="sidebar-footer">
            <p>Made with ♡</p>
            <strong>Spotipart 2026</strong>
        </div>

    </aside>


    <!-- MAIN CONTENT -->
    <main class="main-content">

        <!-- TOP BAR -->
        <header class="top-bar">

            <div class="navigation-arrows">
                <button title="Go back">‹</button>
                <button title="Go forward">›</button>
            </div>

            <div class="search-container">
                <span>⌕</span>

                <input
                    type="text"
                    id="searchInput"
                    placeholder="What do you want to listen to?"
                >

                <button id="clearSearchBtn" title="Clear search">×</button>
            </div>

            <div class="user-badge">
                <span class="user-avatar">A</span>
                <span>Aparrt69</span>
            </div>

        </header>


        <!-- HOME VIEW -->
        <section id="homeView" class="content-view">

            <section class="hero-banner">

                <div class="hero-art">
                    <div class="hero-art-circle">♫</div>
                </div>

                <div class="hero-text">

                    <span class="tag">FEATURED PLAYLIST</span>

                    <h2>Chill Vibes 2026</h2>

                    <p>
                        Your personal soundtrack for coding,
                        studying, and relaxing.
                    </p>

                    <div class="hero-buttons">
                        <button id="playAllBtn" class="primary-btn">
                            ▶ Play All
                        </button>

                        <button id="shuffleAllBtn" class="secondary-btn">
                            🔀 Shuffle
                        </button>
                    </div>

                </div>

            </section>


            <!-- QUICK ACCESS -->
            <section class="quick-access">

                <div class="quick-card">
                    <div class="quick-card-art purple">♡</div>
                    <span>Favorites</span>
                </div>

                <div class="quick-card">
                    <div class="quick-card-art green">♫</div>
                    <span>Chill Vibe</span>
                </div>

                <div class="quick-card">
                    <div class="quick-card-art orange">♪</div>
                    <span>Recently Played</span>
                </div>

            </section>

            <section class="tracks-section">

                <div class="section-heading">
                    <div>
                        <span class="section-label">YOUR MUSIC</span>
                        <h2>Recently Added</h2>
                    </div>
                </div>

                <div class="tracks-header">
                    <span>#</span>
                    <span>Title</span>
                    <span>Album</span>
                    <span>Duration</span>
                    <span></span>
                </div>

                <div id="tracksContainer" class="tracks-list">
                    <!-- Generated by JavaScript -->
                </div>

                <p id="emptyMessage" class="empty-message" hidden>
                    No songs found.
                </p>

            </section>

        </section>


        <!-- SEARCH VIEW -->
        <section id="searchView" class="content-view" hidden>

            <div class="page-heading">
                <span class="section-label">DISCOVER</span>
                <h2>Search Music</h2>
                <p>Find your favorite songs and artists.</p>
            </div>

            <div class="search-large">
                <span>⌕</span>
                <input
                    type="text"
                    id="largeSearchInput"
                    placeholder="Search songs or artists..."
                >
            </div>

            <div id="searchResults" class="tracks-list"></div>

        </section>


        <!-- LIBRARY VIEW -->
        <section id="libraryView" class="content-view" hidden>

            <div class="page-heading">
                <span class="section-label">YOUR COLLECTION</span>
                <h2>Your Library</h2>
                <p>All your music in one place.</p>
            </div>

            <div class="library-stats">
                <div class="stat-card">
                    <strong id="songCount">0</strong>
                    <span>Songs</span>
                </div>

                <div class="stat-card">
                    <strong id="playlistCount">0</strong>
                    <span>Playlists</span>
                </div>
            </div>

            <div id="libraryTracks" class="tracks-list"></div>

        </section>


        <!-- PLAYLIST VIEW -->
        <section id="playlistView" class="content-view" hidden>

            <div class="page-heading">
                <span class="section-label">YOUR PLAYLIST</span>
                <h2 id="playlistTitle">Playlist</h2>
                <p id="playlistDescription">Your selected songs.</p>

                <button id="playlistPlayBtn" class="primary-btn">
                    ▶ Play Playlist
                </button>
            </div>

            <div id="playlistTracks" class="tracks-list"></div>

        </section>

    </main>

</div>


<!-- BOTTOM MUSIC PLAYER -->
<footer class="player-bar">

    <!-- SONG INFORMATION -->
    <div class="now-playing">

        <div id="playerArt" class="player-art">
            ♫
        </div>

        <div class="player-song-info">
            <strong id="playerTitle">Select a track</strong>
            <p id="playerArtist">Spotipart Player</p>
        </div>

    </div>


    <!-- PLAYER CONTROLS -->
    <div class="player-center">

        <div class="control-buttons">

            <button id="shuffleBtn" title="Shuffle">🔀</button>

            <button id="prevBtn" title="Previous">⏮</button>

            <button id="playBtn" class="play-circle" title="Play">
                ▶
            </button>

            <button id="nextBtn" title="Next">⏭</button>

            <button id="repeatBtn" title="Repeat">🔁</button>

        </div>


        <div class="progress-wrap">

            <span id="currentTime">0:00</span>

            <input
                type="range"
                id="progressBar"
                value="0"
                min="0"
                max="100"
                step="0.1"
            >

            <span id="totalDuration">0:00</span>

        </div>

    </div>


    <!-- VOLUME -->
    <div class="volume-wrap">

        <span>🔊</span>

        <input
            type="range"
            id="volumeBar"
            value="80"
            min="0"
            max="100"
        >

    </div>

</footer>


<!-- REAL AUDIO ELEMENT -->
<audio id="audioPlayer" preload="metadata"></audio>


<script src="script.js"></script>

</body>
</html>
