
:root {
    --bg-dark: #121212;
    --bg-sidebar: #080808;
    --bg-card: #181818;
    --bg-hover: #282828;

    --primary: #1ed760;
    --primary-hover: #1fdf64;

    --text-white: #ffffff;
    --text-muted: #a7a7a7;

    --border: #292929;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background: var(--bg-dark);
    color: var(--text-white);
    font-family: 'Inter', sans-serif;
    min-height: 100vh;
    overflow: hidden;
}

/* APP LAYOUT */

.app-layout {
    display: grid;
    grid-template-columns: 245px 1fr;
    height: calc(100vh - 90px);
}

/* SIDEBAR */

.sidebar {
    background: var(--bg-sidebar);
    padding: 28px 18px;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
}

.logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 25px;
    font-weight: 800;
    color: var(--primary);
    margin-bottom: 35px;
}

.logo-icon {
    font-size: 32px;
}

.nav-links {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.nav-link {
    border: none;
    background: transparent;
    color: var(--text-muted);
    padding: 13px;
    border-radius: 7px;
    text-align: left;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: 0.2s;
}

.nav-link span {
    font-size: 20px;
    margin-right: 12px;
}

.nav-link:hover,
.nav-link.active {
    color: white;
    background: var(--bg-hover);
}

.sidebar-divider {
    height: 1px;
    background: var(--border);
    margin: 25px 0;
}

.playlist-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
}

.playlist-heading h3 {
    font-size: 13px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 1px;
}

.playlist-heading button {
    background: transparent;
    border: none;
    color: white;
    font-size: 25px;
    cursor: pointer;
}

.playlist-list {
    list-style: none;
}

.playlist-list li {
    padding: 11px 9px;
    color: var(--text-muted);
    font-size: 13px;
    border-radius: 5px;
    cursor: pointer;
}

.playlist-list li:hover,
.playlist-list li.active {
    background: var(--bg-hover);
    color: white;
}

.sidebar-footer {
    margin-top: auto;
    padding-top: 30px;
    color: #777;
    font-size: 12px;
    line-height: 1.8;
}

/* MAIN CONTENT */

.main-content {
    overflow-y: auto;
    padding: 25px 35px 110px;
    background:
        linear-gradient(
            180deg,
            #1c3b2a 0px,
            #17251c 250px,
            #121212 500px
        );
}

.main-content::-webkit-scrollbar,
.sidebar::-webkit-scrollbar {
    width: 7px;
}

.main-content::-webkit-scrollbar-thumb,
.sidebar::-webkit-scrollbar-thumb {
    background: #444;
    border-radius: 10px;
}

/* TOP BAR */

.top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 35px;
}

.navigation-arrows {
    display: flex;
    gap: 8px;
}

.navigation-arrows button {
    width: 35px;
    height: 35px;
    border: none;
    border-radius: 50%;
    background: #101010;
    color: white;
    font-size: 24px;
    cursor: pointer;
}

.search-container {
    display: flex;
    align-items: center;
    background: #242424;
    border-radius: 30px;
    padding: 0 15px;
    width: min(400px, 55%);
}

.search-container span {
    font-size: 24px;
    color: var(--text-muted);
}

.search-container input {
    background: transparent;
    border: none;
    outline: none;
    color: white;
    padding: 13px 10px;
    width: 100%;
}

.search-container button {
    background: transparent;
    border: none;
    color: white;
    font-size: 22px;
    cursor: pointer;
}

.user-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #080808;
    padding: 5px 12px 5px 5px;
    border-radius: 30px;
    font-size: 12px;
    font-weight: 600;
}

.user-avatar {
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    background: #7c3aed;
    border-radius: 50%;
}

/* HERO BANNER */

.hero-banner {
    display: flex;
    align-items: center;
    gap: 28px;
    margin-bottom: 35px;
    padding: 25px;
    background: linear-gradient(120deg, #236b3b, #153b26);
    border-radius: 12px;
}

.hero-art {
    width: 175px;
    height: 175px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #1ed760, #075b2b);
    border-radius: 9px;
    box-shadow: 0 10px 30px #0006;
}

.hero-art-circle {
    font-size: 85px;
    color: white;
}

.tag,
.section-label {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.5px;
    color: var(--primary);
}

.hero-text h2 {
    font-size: clamp(26px, 4vw, 43px);
    margin: 10px 0;
}

.hero-text p {
    color: #d0d0d0;
    font-size: 13px;
    line-height: 1.6;
}

.hero-buttons {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
}

.primary-btn,
.secondary-btn {
    border: none;
    border-radius: 30px;
    padding: 12px 25px;
    margin-top: 18px;
    font-weight: 800;
    cursor: pointer;
    transition: 0.2s;
}

.primary-btn {
    background: var(--primary);
    color: #000;
}

.primary-btn:hover {
    background: var(--primary-hover);
    transform: scale(1.04);
}

.secondary-btn {
    background: #ffffff20;
    color: white;
}

.secondary-btn:hover {
    background: #ffffff35;
}

/* QUICK ACCESS */

.quick-access {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
    margin-bottom: 40px;
}

.quick-card {
    display: flex;
    align-items: center;
    gap: 12px;
    background: #ffffff12;
    border-radius: 6px;
    overflow: hidden;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s;
}

.quick-card:hover {
    background: #ffffff25;
}

.quick-card-art {
    width: 60px;
    height: 60px;
    display: grid;
    place-items: center;
    font-size: 27px;
}

.purple {
    background: linear-gradient(135deg, #a855f7, #4c1d95);
}

.green {
    background: linear-gradient(135deg, #1ed760, #075b2b);
}

.orange {
    background: linear-gradient(135deg, #f59e0b, #9a3412);
}

/* TRACK SECTION */

.tracks-section {
    margin-top: 20px;
}

.section-heading {
    margin-bottom: 20px;
}

.section-heading h2,
.page-heading h2 {
    font-size: 26px;
    margin-top: 8px;
}

.tracks-header,
.track-item {
    display: grid;
    grid-template-columns: 35px minmax(160px, 2fr) minmax(100px, 1.2fr) 65px 35px;
    align-items: center;
    gap: 12px;
    padding: 11px 13px;
}

.tracks-header {
    color: var(--text-muted);
    font-size: 12px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 8px;
}

.track-item {
    min-height: 66px;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.2s;
}

.track-item:hover,
.track-item.playing {
    background: #ffffff17;
}

.track-item.playing .track-title {
    color: var(--primary);
}

.track-number {
    color: var(--text-muted);
    font-size: 13px;
}

.track-info {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
}

.track-image {
    width: 45px;
    height: 45px;
    object-fit: cover;
    border-radius: 5px;
    background: #333;
    flex-shrink: 0;
}

.track-details {
    min-width: 0;
}

.track-title {
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.track-artist {
    font-size: 11px;
    color: var(--text-muted);
    margin-top: 5px;
}

.track-album,
.track-duration {
    color: var(--text-muted);
    font-size: 12px;
}

.track-add {
    background: transparent;
    color: var(--text-muted);
    border: none;
    font-size: 20px;
    cursor: pointer;
}

.track-add:hover {
    color: var(--primary);
}

.empty-message {
    color: var(--text-muted);
    text-align: center;
    padding: 40px 10px;
}

/* OTHER VIEWS */

[hidden] {
    display: none !important;
}

.page-heading {
    margin: 30px 0;
}

.page-heading p {
    color: var(--text-muted);
    font-size: 13px;
    margin-top: 10px;
}

.search-large {
    display: flex;
    align-items: center;
    background: white;
    border-radius: 8px;
    padding: 0 18px;
    margin: 25px 0;
}

.search-large span {
    font-size: 25px;
    color: #333;
}

.search-large input {
    border: none;
    outline: none;
    background: transparent;
    padding: 17px 12px;
    width: 100%;
    color: #111;
}

.library-stats {
    display: flex;
    gap: 15px;
    margin: 25px 0;
}

.stat-card {
    background: var(--bg-card);
    padding: 22px;
    border-radius: 8px;
    min-width: 140px;
}

.stat-card strong,
.stat-card span {
    display: block;
}

.stat-card strong {
    font-size: 25px;
    margin-bottom: 5px;
}

.stat-card span {
    color: var(--text-muted);
    font-size: 12px;
}

/* BOTTOM PLAYER */

.player-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 90px;
    background: #181818;
    border-top: 1px solid var(--border);
    display: grid;
    grid-template-columns: 1fr 1.5fr 1fr;
    align-items: center;
    gap: 15px;
    padding: 10px 25px;
    z-index: 100;
}

.now-playing {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
}

.player-art {
    width: 55px;
    height: 55px;
    background: linear-gradient(135deg, #1ed760, #075b2b);
    border-radius: 5px;
    display: grid;
    place-items: center;
    font-size: 25px;
    flex-shrink: 0;
    overflow: hidden;
}

.player-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.player-song-info {
    min-width: 0;
}

.player-song-info strong {
    font-size: 12px;
    display: block;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.player-song-info p {
    font-size: 11px;
    color: var(--text-muted);
    margin-top: 5px;
}

.player-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 7px;
}

.control-buttons {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
}

.control-buttons button {
    background: transparent;
    color: var(--text-muted);
    border: none;
    font-size: 16px;
    cursor: pointer;
}

.control-buttons button:hover,
.control-buttons button.enabled {
    color: var(--primary);
}

.play-circle {
    width: 35px;
    height: 35px;
    border-radius: 50%;
    background: white !important;
    color: black !important;
    font-size: 14px !important;
}

.play-circle:hover {
    transform: scale(1.08);
}

.progress-wrap {
    display: flex;
    align-items: center;
    width: 100%;
    max-width: 470px;
    gap: 10px;
}

.progress-wrap span {
    color: var(--text-muted);
    font-size: 10px;
    min-width: 30px;
    text-align: center;
}

input[type="range"] {
    accent-color: var(--primary);
    cursor: pointer;
}

#progressBar {
    width: 100%;
    height: 4px;
}

.volume-wrap {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
}

.volume-wrap span {
    font-size: 15px;
}

#volumeBar {
    width: 100px;
}

/* RESPONSIVE DESIGN */

@media (max-width: 900px) {

    .app-layout {
        grid-template-columns: 190px 1fr;
    }

    .main-content {
        padding: 20px 20px 110px;
    }

    .player-bar {
        grid-template-columns: 1fr 1.5fr;
    }

    .volume-wrap {
        display: none;
    }

    .quick-access {
        grid-template-columns: repeat(2, 1fr);
    }

}

@media (max-width: 600px) {

    body {
        overflow: hidden;
    }

    .app-layout {
        display: block;
        height: calc(100vh - 145px);
    }

    .sidebar {
        height: auto;
        padding: 10px 14px;
        display: block;
    }

    .logo {
        font-size: 21px;
        margin-bottom: 10px;
    }

    .nav-links {
        flex-direction: row;
        justify-content: space-between;
        gap: 5px;
    }

    .nav-link {
        flex: 1;
        text-align: center;
        padding: 9px 3px;
        font-size: 11px;
    }

    .nav-link span {
        margin-right: 3px;
        font-size: 15px;
    }

    .sidebar-divider,
    .playlist-heading,
    .playlist-list,
    .sidebar-footer {
        display: none;
    }

    .main-content {
        height: calc(100% - 94px);
        padding: 15px 15px 25px;
    }

    .top-bar {
        margin-bottom: 20px;
        gap: 8px;
    }

    .navigation-arrows {
        display: none;
    }

    .search-container {
        width: 100%;
    }

    .user-badge {
        display: none;
    }

    .hero-banner {
        padding: 15px;
        gap: 15px;
    }

    .hero-art {
        width: 105px;
        height: 105px;
    }

    .hero-art-circle {
        font-size: 50px;
    }

    .hero-text h2 {
        font-size: 21px;
    }

    .hero-text p {
        font-size: 11px;
    }

    .primary-btn,
    .secondary-btn {
        padding: 10px 14px;
        font-size: 11px;
    }

    .quick-access {
        grid-template-columns: 1fr 1fr;
        gap: 8px;
    }

    .quick-card-art {
        width: 45px;
        height: 45px;
    }

    .quick-card {
        font-size: 11px;
    }

    .tracks-header,
    .track-item {
        grid-template-columns: 22px minmax(100px, 1fr) 45px 25px;
        gap: 7px;
        padding: 9px 5px;
    }

    .tracks-header span:nth-child(3),
    .track-item .track-album {
        display: none;
    }

    .track-image {
        width: 38px;
        height: 38px;
    }

    .track-title {
        font-size: 11px;
    }

    .track-artist {
        font-size: 10px;
    }

    .track-duration {
        font-size: 10px;
    }

    .player-bar {
        height: 145px;
        grid-template-columns: 1fr;
        gap: 7px;
        padding: 10px 15px;
    }

    .now-playing {
        justify-content: center;
    }

    .player-art {
        width: 38px;
        height: 38px;
    }

    .player-center {
        gap: 5px;
    }

    .control-buttons {
        gap: 22px;
    }

    .progress-wrap {
        max-width: 100%;
    }

    .library-stats {
        flex-wrap: wrap;
    }

}
